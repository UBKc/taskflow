# ------------------------------------------------------------
# TaskFlow Backend - .env örneği
# Bu dosyayı "backend/.env" olarak kopyalayın ve değerleri doldurun.
# ------------------------------------------------------------

# Sunucu
PORT=4000
NODE_ENV=development

# PostgreSQL bağlantısı
# docker-compose.yml ile ayağa kaldırıldığında host "localhost" olur.
DATABASE_URL=postgres://taskflow:taskflow@localhost:5432/taskflow

# JWT
JWT_SECRET=super-gizli-anahtar-degistir
JWT_EXPIRES_IN=1d

# CORS — yalnızca frontend origin'ine izin verilir (2. faz güvenlik sertleştirme)
CORS_ORIGIN=http://localhost:5173
